# Groq Cloud API Key (Recomandat pentru viteză extremă pe Llama 3.3 70B: ~800ms)
# Obține o cheie gratuită de pe https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here

# NVIDIA NIM Inference API Key (Fallback)
# Obține o cheie gratuită de pe https://build.nvidia.com/
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here

# Supabase Configuration (Opțional pentru persistență remote)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

